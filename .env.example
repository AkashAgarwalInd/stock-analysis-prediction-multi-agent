# Application
APP_NAME=stock-analysis
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=console

# Database
DATABASE_PATH=data/stock_analysis.db
DATABASE_ECHO=false

# Gemini API (required for LLM features)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_PRIMARY=gemini-3.5-flash-lite
GEMINI_MODEL_CRITIC=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-8b-lite
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_TOKENS=8192

# NSE Data Cache
NSE_DATA_CACHE_DIR=data/cache

# Forecast
FORECAST_HORIZON_DAYS=5
# Forecast pipeline (Phase 6)
MAX_REVISIONS=2
PREDICTOR_MAX_PROB_SHIFT=0.15
# Learning: apply bounded calibration to new forecasts (Plan.md §23)
LEARNING_ENABLED=true

# Hardening (Plan.md Phase 18): rate limits per minute (0 = off) and burst size
LLM_REQUESTS_PER_MINUTE=30
LLM_RATE_LIMIT_BURST=4
YFINANCE_REQUESTS_PER_MINUTE=120
NEWS_REQUESTS_PER_MINUTE=30
# Retries with exponential backoff (total attempts per call)
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_SECONDS=2
EXTERNAL_RETRY_ATTEMPTS=3
EXTERNAL_RETRY_BASE_DELAY_SECONDS=1
# Per-request timeouts (seconds)
LLM_REQUEST_TIMEOUT_SECONDS=120
EXTERNAL_REQUEST_TIMEOUT_SECONDS=30
# One re-prompt when LLM output violates its schema
LLM_STRUCTURED_OUTPUT_REPAIR=true
# Cost tracking: estimated USD per million tokens (set to your model's prices)
LLM_INPUT_COST_PER_MILLION_TOKENS=0.10
LLM_OUTPUT_COST_PER_MILLION_TOKENS=0.40
# Most LLM calls one forecast run may make (0 = no limit)
LLM_MAX_CALLS_PER_RUN=40
